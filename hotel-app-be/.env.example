# Hotel Management System - Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
# Options: development, staging, production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_MIN_16_CHARS
POSTGRES_DB=hotel_management
POSTGRES_PORT=5432

# Database Performance Tuning
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# Database Resource Limits
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512M

# =============================================================================
# REDIS CACHE (Optional - for production)
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
BACKEND_PORT=3030
BACKEND_HOST=0.0.0.0

# Database Connection String (Required)
# Format: postgres://username:password@host:port/database
# For Docker Compose: use 'postgres' as host (service name)
# For local development: use 'localhost' as host
DATABASE_URL=postgres://hotel_admin:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/hotel_management

# Database Connection Pool (all optional — sensible defaults applied when unset).
# Read by hotel-app-be/src/core/db.rs::create_pool.
DATABASE_MAX_CONNECTIONS=20          # PostgreSQL pool ceiling
DATABASE_MIN_CONNECTIONS=0           # warm floor (default 0 = lazy). sqlx opens this
                                     # many connections eagerly at startup and waits
                                     # for them, so only raise it once connectivity is
                                     # confirmed — a non-zero value blocks startup if
                                     # the database can't immediately accept connections.
DATABASE_ACQUIRE_TIMEOUT_SECS=30     # max wait to check out a connection
DATABASE_IDLE_TIMEOUT_SECS=600       # close connections idle longer than this (PostgreSQL)
DATABASE_MAX_LIFETIME_SECS=1800      # recycle connections after this age (PostgreSQL)
DATABASE_SLOW_STATEMENT_MS=500       # log any statement slower than this at WARN

# RBAC permission/role cache TTL (seconds). The per-request permission check is
# served from an in-process cache; RBAC mutations invalidate it immediately, so
# this only bounds drift from direct out-of-band database edits.
RBAC_CACHE_TTL_SECS=30

# System settings cache TTL (seconds). Admin setting updates invalidate the
# affected key immediately; this only bounds drift from direct DB edits.
SETTINGS_CACHE_TTL_SECS=30

# JWT Security (Required - minimum 32 characters)
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_MIN_32_CHARACTERS_LONG_FOR_SECURITY
# Issuer/audience are verified on every staff JWT. Keep these stable across
# rolling deployments; changing either intentionally invalidates all access tokens.
JWT_ISSUER=hotel-app-be
JWT_AUDIENCE=hotel-web
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800

# CORS Settings (Required - comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
# Set true ONLY behind a trusted TLS-terminating proxy (e.g. the docker compose
# `https` profile's Caddy service — see docs/guides/deployment.md and SECURITY.md).
TRUST_PROXY_HEADERS=false

# Passkey/WebAuthn relying party ID (domain/host users authenticate against).
PASSKEY_RP_ID=localhost

# Desktop mode
# HOTEL_DESKTOP_MODE=true
# HOTEL_LOG_DIR=./logs
# SKIP_EMAIL_VERIFICATION=false

# Logging
RUST_LOG=info
RUST_BACKTRACE=0

# Backend Resource Limits
BACKEND_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=512M
BACKEND_REPLICAS=1

# Backend Version (for Docker image tagging)
BACKEND_VERSION=latest

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
NODE_VERSION=18

# API URLs
REACT_APP_API_URL=http://localhost:3030
REACT_APP_WS_URL=ws://localhost:3030
REACT_APP_ENVIRONMENT=production

# Frontend Version (for Docker image tagging)
FRONTEND_VERSION=latest

# =============================================================================
# NGINX REVERSE PROXY (Production)
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
GRAFANA_PLUGINS=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Cron schedule format: minute hour day month weekday
# Default: 2 AM daily
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# GUEST PORTAL PAYMENTS (bank transfer + PayPal)
# =============================================================================
# PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the PayPal developer dashboard (Apps & Credentials -> your
# app -> Webhooks; subscribe at least PAYMENT.CAPTURE.COMPLETED and
# PAYMENT.CAPTURE.DENIED to https://<your-domain>/api/webhooks/paypal).
# Without it the webhook endpoint refuses deliveries with 503.
# PAYPAL_WEBHOOK_ID=
# HOTEL_BANK_NAME=
# HOTEL_BANK_ACCOUNT_NAME=
# HOTEL_BANK_ACCOUNT_NUMBER=

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# Read by modules::communications::transport::SmtpConfig::from_env().
#
# The transport is built ONLY when both SMTP_HOST and SMTP_FROM_EMAIL are set
# and non-blank. Otherwise from_env() returns None and the delivery worker
# logs that it is inert and exits -- the process still starts normally, guest
# email simply accumulates in the email_deliveries outbox unsent.
#
# Setting these is the prerequisite for any operational email alerting: an
# alerter cannot notify you through a transport that does not exist.
#
# In production these live in /opt/saliminn/secrets.env (root-owned, 0600),
# which deploy.sh sources before invoking docker compose. Never commit real
# values -- gitleaks runs over full history on every push.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # default 587
# SMTP_USERNAME=
# SMTP_PASSWORD=                    # app password, not an account password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Salim Inn
# SMTP_SECURITY=starttls            # starttls (default) | tls | none
#
# Port/security pairing: 587 -> starttls, 465 -> tls. "none" disables
# transport encryption and must only ever be used against a local relay.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
NETWORK_SUBNET=172.28.0.0/16

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment these for development mode

# ENVIRONMENT=development
# RUST_LOG=debug
# RUST_BACKTRACE=1
# CORS_ALLOWED_ORIGINS=*
# FRONTEND_PORT=3000
# BACKEND_PORT=3030
