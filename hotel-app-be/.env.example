# hotel-app-be — backend process environment reference
#
# Copy to .env and edit. Every variable below is read by the backend at startup
# (core/config.rs, core/db.rs, or modules/communications). Nothing here is
# aspirational — if a name is listed, some code reads it.
#
# For the Docker Compose stack, use the repository-root .env.example instead:
# compose owns the Postgres credentials, ports, image tags, and TLS settings,
# and passes the relevant values below into the backend container.

# =============================================================================
# ENVIRONMENT (required in production)
# =============================================================================
# development | staging | production. APP_ENV is checked first, ENVIRONMENT second.
# Production refuses insecure combinations: wildcard/localhost ALLOWED_ORIGINS,
# a default PASSKEY_RP_ID, or SKIP_EMAIL_VERIFICATION=true.
ENVIRONMENT=production

# =============================================================================
# DATABASE (DATABASE_URL required)
# =============================================================================
# Format: postgres://username:password@host:port/database
# Docker Compose: host is 'postgres' (the service name).
# Local: 127.0.0.1, NOT 'localhost'. Docker publishes the PostgreSQL 19
# container on 127.0.0.1:5432 (IPv4 only), so any other local PostgreSQL
# bound to ::1:5432 also owns 'localhost' — and which one a client reaches
# then depends on how it resolves the name, silently, run to run. That has
# already sent a test run at a stale server whose schema predates the V1
# baseline. 127.0.0.1 can only be the container.
DATABASE_URL=postgres://hotel_admin:CHANGE_ME_TO_STRONG_PASSWORD@127.0.0.1:5432/hotel_management

# Connection pool — all optional, sensible defaults when unset.
# Read by core/db.rs::create_pool.
DATABASE_MAX_CONNECTIONS=20          # pool ceiling
DATABASE_MIN_CONNECTIONS=0           # warm floor (default 0 = lazy). sqlx opens this
                                     # many connections eagerly at startup and waits
                                     # for them, so only raise it once connectivity is
                                     # confirmed — a non-zero value blocks startup if
                                     # the database can't immediately accept connections.
DATABASE_ACQUIRE_TIMEOUT_SECS=30     # max wait to check out a connection
DATABASE_IDLE_TIMEOUT_SECS=600       # close connections idle longer than this
DATABASE_MAX_LIFETIME_SECS=1800      # recycle connections after this age
DATABASE_SLOW_STATEMENT_MS=500       # log any statement slower than this at WARN

# =============================================================================
# HTTP SERVER
# =============================================================================
BACKEND_PORT=3030

# Comma-separated allowed CORS origins. Required to be non-wildcard,
# non-localhost, HTTPS-only in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set true ONLY behind a trusted TLS-terminating proxy that overwrites
# X-Forwarded-For and X-Real-IP (e.g. the compose `https` profile's Caddy
# service). See docs/guides/deployment.md and SECURITY.md.
TRUST_PROXY_HEADERS=false

# Public origin used to build absolute links (e.g. guest portal emails).
# PUBLIC_BASE_URL=https://hotel.example.com

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Required, minimum 32 characters. Rotating it invalidates all staff access tokens.
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_MIN_32_CHARACTERS_LONG_FOR_SECURITY

# Verified on every staff JWT. Keep stable across rolling deployments;
# changing either intentionally invalidates all access tokens.
JWT_ISSUER=hotel-app-be
JWT_AUDIENCE=hotel-web

# Passkey/WebAuthn relying party ID (the domain users authenticate against).
PASSKEY_RP_ID=localhost

# Google Sign-In (guest accounts only). Optional — when unset, Google sign-in
# returns 503 rather than failing open. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (hotel-web-fe/.env.example) — the same OAuth client.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Must remain false in production; startup refuses true.
SKIP_EMAIL_VERIFICATION=false

# =============================================================================
# CACHES
# =============================================================================
# RBAC mutations and admin setting updates invalidate their cache entries
# immediately, so these only bound drift from direct out-of-band database edits.
RBAC_CACHE_TTL_SECS=30
SETTINGS_CACHE_TTL_SECS=30

# =============================================================================
# LOGGING
# =============================================================================
RUST_LOG=info
RUST_BACKTRACE=0
# HOTEL_LOG_DIR=./logs

# =============================================================================
# DESKTOP MODE
# =============================================================================
# Set only when the backend runs as the Tauri sidecar. The desktop shell sets
# this itself, along with a specific ALLOWED_ORIGINS list and a dynamic port.
# HOTEL_DESKTOP_MODE=true

# =============================================================================
# GUEST PORTAL PAYMENTS (bank transfer + PayPal)
# =============================================================================
# PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the PayPal developer dashboard (Apps & Credentials -> your
# app -> Webhooks; subscribe at least PAYMENT.CAPTURE.COMPLETED and
# PAYMENT.CAPTURE.DENIED to https://<your-domain>/api/webhooks/paypal).
# Without it the webhook endpoint refuses deliveries with 503.
# PAYPAL_WEBHOOK_ID=
# HOTEL_BANK_NAME=
# HOTEL_BANK_ACCOUNT_NAME=
# HOTEL_BANK_ACCOUNT_NUMBER=

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# Read by modules::communications::transport::SmtpConfig::from_env().
#
# The transport is built ONLY when both SMTP_HOST and SMTP_FROM_EMAIL are set
# and non-blank. Otherwise from_env() returns None and the delivery worker
# logs that it is inert and exits -- the process still starts normally, guest
# email simply accumulates in the email_deliveries outbox unsent.
#
# Setting these is the prerequisite for any operational email alerting: an
# alerter cannot notify you through a transport that does not exist.
#
# In production these live in /opt/saliminn/secrets.env (root-owned, 0600),
# which deploy.sh sources before invoking docker compose. Never commit real
# values -- gitleaks runs over full history on every push.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # default 587
# SMTP_USERNAME=
# SMTP_PASSWORD=                    # app password, not an account password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Salim Inn
# SMTP_SECURITY=starttls            # starttls (default) | tls | none
#
# Port/security pairing: 587 -> starttls, 465 -> tls. "none" disables
# transport encryption and must only ever be used against a local relay.

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# ENVIRONMENT=development
# RUST_LOG=debug
# RUST_BACKTRACE=1
