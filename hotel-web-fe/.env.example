# Frontend build-time environment (Vite). Copy to .env.local for local overrides;
# Vite only exposes variables prefixed VITE_ to client code (import.meta.env).

# Google Sign-In client ID (see GoogleSignInButton.tsx). Must match the backend's
# GOOGLE_CLIENT_ID (hotel-app-be/.env.example) — they are the same OAuth client.
# Without it, the Google sign-in button renders disabled.
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Optional: override the API base URL. Leave unset for normal dev (Vite proxies
# /api to 127.0.0.1:3030) and for web production (same-origin dynamic routing).
# VITE_API_URL=http://127.0.0.1:3030
