{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotel Management System",
  "version": "1.0.0",
  "identifier": "com.hotelapp.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "bun run start:tauri",
      "cwd": "../hotel-web-fe"
    },
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "bun run desktop:prepare",
    "frontendDist": "../../hotel-web-fe/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Hotel Management System",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hotel-app-be"
    ],
    "resources": [
      "pgsql/bin/**/*",
      "pgsql/lib/**/*",
      "pgsql/share/**/*",
      "database/schema.sql",
      "database/data.sql"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://REPLACE_WITH_YOUR_UPDATE_HOST/hotel-app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
