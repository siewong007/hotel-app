prefix=/opt/homebrew/Cellar/postgresql@18/18.4
exec_prefix=${prefix}
libdir=/opt/homebrew/lib/postgresql@18
includedir=/opt/homebrew/include/postgresql@18

Name: libecpg_compat
Description: PostgreSQL libecpg_compat library
URL: https://www.postgresql.org/
Version: 18.4
Requires: 
Requires.private: libecpg, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg_compat
Libs.private: -L/opt/homebrew/opt/gettext/lib -L/opt/homebrew/opt/krb5/lib -L/opt/homebrew/opt/lz4/lib -L/opt/homebrew/opt/openssl@3/lib -L/opt/homebrew/opt/readline/lib -L/opt/homebrew/opt/zstd/lib -lecpg -lpgcommon -lpgport -lpq -lintl -lm
