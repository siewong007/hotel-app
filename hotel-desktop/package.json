{
  "name": "hotel-desktop",
  "version": "1.0.0",
  "description": "Hotel Management System - Desktop Application",
  "scripts": {
    "tauri": "bun scripts/tauri-cli.mjs",
    "dev": "bun scripts/tauri-cli.mjs dev",
    "build": "bun scripts/tauri-build.mjs",
    "build:debug": "bun scripts/tauri-build.mjs --debug --backend-profile debug",
    "build:fast": "bun scripts/tauri-build.mjs --debug --no-bundle --backend-profile debug",
    "build:no-bundle": "bun scripts/tauri-build.mjs --no-bundle",
    "build:msi": "bun scripts/tauri-build.mjs --bundles msi",
    "build:nsis": "bun scripts/tauri-build.mjs --bundles nsis",
    "provision:pgsql": "bun scripts/provision-pgsql.mjs",
    "provision:pgsql:force": "bun scripts/provision-pgsql.mjs --force",
    "sync:resources": "bun scripts/sync-desktop-resources.mjs",
    "sync:resources:force": "bun scripts/sync-desktop-resources.mjs --force",
    "build:frontend": "bun scripts/build-frontend.mjs --force",
    "build:frontend:cached": "bun scripts/build-frontend.mjs",
    "build:frontend:force": "bun scripts/build-frontend.mjs --force",
    "build:backend": "bun scripts/build-backend-sidecar.mjs",
    "build:backend:debug": "bun scripts/build-backend-sidecar.mjs --profile debug",
    "build:backend:force": "bun scripts/build-backend-sidecar.mjs --force",
    "copy:backend": "bun scripts/copy-backend-sidecar.mjs",
    "copy:backend:debug": "bun scripts/copy-backend-sidecar.mjs --profile debug",
    "copy:backend:force": "bun scripts/copy-backend-sidecar.mjs --force",
    "desktop:prepare": "bun scripts/desktop-prepare.mjs",
    "desktop:prepare:force": "bun scripts/desktop-prepare.mjs --force"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
