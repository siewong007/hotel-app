{
  "name": "hotel-desktop",
  "version": "1.0.0",
  "description": "Hotel Management System - Desktop Application",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "node scripts/tauri-build.mjs --debug --backend-profile debug",
    "build:fast": "node scripts/tauri-build.mjs --debug --no-bundle --backend-profile debug",
    "build:no-bundle": "node scripts/tauri-build.mjs --no-bundle",
    "build:msi": "node scripts/tauri-build.mjs --bundles msi",
    "build:nsis": "node scripts/tauri-build.mjs --bundles nsis",
    "sync:resources": "node scripts/sync-desktop-resources.mjs",
    "sync:resources:force": "node scripts/sync-desktop-resources.mjs --force",
    "build:frontend": "npm --prefix ../hotel-web-fe run build:tauri",
    "build:frontend:cached": "node scripts/build-frontend.mjs",
    "build:frontend:force": "node scripts/build-frontend.mjs --force",
    "build:backend": "node scripts/build-backend-sidecar.mjs",
    "build:backend:debug": "node scripts/build-backend-sidecar.mjs --profile debug",
    "build:backend:force": "node scripts/build-backend-sidecar.mjs --force",
    "copy:backend": "node scripts/copy-backend-sidecar.mjs",
    "copy:backend:debug": "node scripts/copy-backend-sidecar.mjs --profile debug",
    "copy:backend:force": "node scripts/copy-backend-sidecar.mjs --force",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:prepare:force": "node scripts/desktop-prepare.mjs --force"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
