{
	# Quoted so an unset ACME_EMAIL still parses (empty = no ACME contact email).
	email "{$ACME_EMAIL}"
}

{$DOMAIN} {
	encode zstd gzip

	# Backend already sends HSTS on API responses; '?' sets it only when absent
	# (i.e. on frontend/static responses).
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# KEEP IN SYNC with PROXY_PREFIXES in hotel-web-fe/vite.config.ts
	@backend path /api/* /uploads/* /health /ws /ws/*
	handle @backend {
		reverse_proxy backend:3030
	}

	handle {
		reverse_proxy frontend:80
	}
}
