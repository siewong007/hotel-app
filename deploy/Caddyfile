{
	# Quoted so an unset ACME_EMAIL still parses (empty = no ACME contact email).
	email "{$ACME_EMAIL}"
}

{$DOMAIN} {
	encode zstd gzip

	# HSTS. '?' sets the header only when absent. Parameterized so local HTTPS
	# (DOMAIN=localhost in docker-compose.yml) can send max-age=0: an HSTS pin
	# on the host "localhost" applies to EVERY port, force-upgrading the plain
	# HTTP Vite dev server on :3000 to https and breaking it (notably in
	# Safari). Unset (production/VPS) the default below preserves the original
	# hardened value byte-for-byte. (Note: the backend does NOT send HSTS
	# itself — verified 2026-07-19 — this edge header is the only source.)
	header ?Strict-Transport-Security "{$HSTS_VALUE:max-age=31536000; includeSubDomains}"

	# KEEP IN SYNC with PROXY_PREFIXES in hotel-web-fe/vite.config.ts
	@backend path /api/* /uploads/* /health /ws /ws/*
	handle @backend {
		reverse_proxy backend:3030
	}

	handle {
		reverse_proxy frontend:80
	}
}
