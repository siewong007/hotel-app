# Hotel app — Docker Compose environment
#
# Copy to .env at the repository root; `docker compose` reads it automatically.
# At minimum change POSTGRES_PASSWORD and JWT_SECRET before starting the stack.
#
# Every variable here is substituted by docker-compose.yml,
# deploy/docker-compose.prod.yml, or passed through to the backend container.
# The full backend-process reference is hotel-app-be/.env.example.

# =============================================================================
# POSTGRES — you must fill this in
# =============================================================================
# Deliberately blank: compose treats POSTGRES_PASSWORD as required and refuses
# to start until it is set, so an unedited copy of this file cannot bring the
# stack up on a weak or published credential. Use 16+ random characters, e.g.
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=
POSTGRES_DB=hotel_management

# =============================================================================
# BACKEND
# =============================================================================
ENVIRONMENT=production
BACKEND_PORT=3030

# Also deliberately blank and also required by compose. At least 32 random
# characters; rotating it invalidates every staff access token.
#   openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=

# Optional: AES-256 key material (base64 of 32 bytes, 64-char hex, or any
# ASCII string >= 32 chars) used to encrypt TOTP secrets at rest. When set,
# new/rotated 2FA secrets are stored as `enc1:` ciphertext; existing plaintext
# rows keep working and re-encrypt on their next setup cycle.
# Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HEADERS=false
RUST_LOG=info

# Absolute origin used when building links in outbound guest email.
# PUBLIC_BASE_URL=https://hotel.example.com

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_PORT=80

# Leave empty for dynamic same-origin API routing. The Vite development proxy
# and the production reverse proxy forward backend paths, so DOMAIN can change
# without a frontend rebuild.
VITE_API_URL=
VITE_APP_TARGET=web

# =============================================================================
# HTTPS DEPLOYMENT (docker compose --profile https up -d --build)
# =============================================================================
# Caddy terminates TLS on one public domain and routes /api, /uploads, /health
# and /ws to the backend; everything else goes to the frontend SPA. Same-origin,
# so the SameSite=Lax refresh cookie is sent. See docs/guides/deployment.md.
# DOMAIN=hotel.example.com
# ACME_EMAIL=you@example.com
# TRUST_PROXY_HEADERS=true                # ONLY behind the trusted proxy (SECURITY.md)
# ALLOWED_ORIGINS=https://hotel.example.com
# HSTS_VALUE=max-age=31536000; includeSubDomains

# Backend/frontend image tag used by deploy/docker-compose.prod.yml.
# IMAGE_TAG=latest

# =============================================================================
# GUEST PORTAL PAYMENTS — passed through to the backend container
# =============================================================================
# PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=
# HOTEL_BANK_NAME=
# HOTEL_BANK_ACCOUNT_NAME=
# HOTEL_BANK_ACCOUNT_NUMBER=

# =============================================================================
# EMAIL (SMTP) — passed through to the backend container
# =============================================================================
# The transport is built only when both SMTP_HOST and SMTP_FROM_EMAIL are set.
# In production these live in /opt/saliminn/secrets.env (root-owned, 0600),
# which deploy.sh sources before invoking docker compose. Never commit real
# values — gitleaks runs over full history on every push.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # 587 -> starttls, 465 -> tls
# SMTP_USERNAME=
# SMTP_PASSWORD=                    # app password, not an account password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=Salim Inn
# SMTP_SECURITY=starttls            # starttls (default) | tls | none

# =============================================================================
# POSTGRESQL 19 TUNING PROFILE (docker-compose.pg19-tuned.yml, opt-in)
# =============================================================================
# Defaults live in that compose file; override only when benchmarking.
# PG19_IO_MIN_WORKERS=
# PG19_IO_MAX_WORKERS=
# PG19_EFFECTIVE_IO_CONCURRENCY=
# PG19_MAINTENANCE_IO_CONCURRENCY=
# PG19_AUTOVACUUM_PARALLEL_WORKERS=
# PG19_AUTOVACUUM_VACUUM_WEIGHT=
# PG19_AUTOVACUUM_ANALYZE_WEIGHT=
# PG19_AUTOVACUUM_INSERT_WEIGHT=
# PG19_EAGER_FREEZE_FAILURE_RATE=
