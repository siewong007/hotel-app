# Hotel app - root environment quick reference
# Copy the values you need into the relevant project-specific .env file.
# The backend full reference is available at hotel-app-be/.env.example.

# Backend API
BACKEND_PORT=3030
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HEADERS=false
RUST_LOG=info
RUST_BACKTRACE=0

# PostgreSQL mode (default backend feature)
DATABASE_URL=postgres://hotel_admin:change_me_password@localhost:5432/hotel_management

# SQLite mode (used with: cargo run --features sqlite --no-default-features)
DATABASE_PATH=./hotel_data.db
DATABASE_BUSY_TIMEOUT_SECS=10

# Database pool tuning
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=0
DATABASE_ACQUIRE_TIMEOUT_SECS=30
DATABASE_IDLE_TIMEOUT_SECS=600
DATABASE_MAX_LIFETIME_SECS=1800
DATABASE_SLOW_STATEMENT_MS=500

# Authentication
JWT_SECRET=change_me_to_a_random_secret_with_at_least_32_characters
SKIP_EMAIL_VERIFICATION=false
PASSKEY_RP_ID=localhost
RBAC_CACHE_TTL_SECS=30
SETTINGS_CACHE_TTL_SECS=30

# Frontend
# Leave empty for dynamic same-origin API routing in web deployments. The Vite
# development proxy and the production reverse proxy forward backend paths.
VITE_API_URL=
VITE_APP_TARGET=web

# HTTPS deployment (docker compose --profile https up -d --build)
# Caddy terminates TLS on one public domain and routes /api, /uploads, /health,
# /ws to the backend; everything else goes to the frontend SPA (same-origin, so
# the SameSite=Strict refresh cookie works). See docs/guides/deployment.md.
# DOMAIN=hotel.example.com
# ACME_EMAIL=you@example.com
# TRUST_PROXY_HEADERS=true                    # ONLY behind the trusted proxy (SECURITY.md)
# ALLOWED_ORIGINS=https://hotel.example.com
# VITE_API_URL=                               # keep empty; DOMAIN can change without a frontend rebuild

# Desktop / logs
HOTEL_LOG_DIR=./logs
# Set only when the backend should run in desktop sidecar mode.
# HOTEL_DESKTOP_MODE=1
